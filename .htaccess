# Util is a library package: no PHP file in it is a web entry point.
#
# Deny direct HTTP requests for any PHP-executable file anywhere beneath this
# directory. Static assets (javascript, css, images) are still served, and PHP
# include/require is unaffected. includes/.htaccess additionally denies every
# file in that subtree.

<FilesMatch "(?i)\.(?:php[0-9]?|phtml|phar|pht)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order Allow,Deny
    Deny from all
  </IfModule>
</FilesMatch>

<FilesMatch "(?i)^(?:\.htaccess|web\.config)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order Allow,Deny
    Deny from all
  </IfModule>
</FilesMatch>
